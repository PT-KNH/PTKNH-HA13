function isAppsScriptEnv() { return !!(window.google && google.script && google.script.run); }
function apiUrl() { return (LS.get(CFG.URL_LS) || DEFAULT_GAS_WEB_APP_URL || '').trim(); }
function cloudAvailable() { return isAppsScriptEnv() || !!apiUrl(); }
function validUrl(v) { return /^https:\/\/script\.google\.com\/.+\/exec\/?(\?.*)?$/.test(v); }
function setStatus(msg) { const el = document.getElementById('cloudSyncStatus'); if (el) el.textContent = msg; }
function openCloudModal() {
  document.getElementById('gasUrlInput').value = apiUrl();
  updateConflictCount();
  document.getElementById('versionInfo').textContent = `หน้าเว็บเวอร์ชัน ${CLIENT_VERSION}`;
  document.getElementById('cloudModal').classList.add('open');
}
function closeCloudModal() { document.getElementById('cloudModal').classList.remove('open'); }
function saveGasUrl() {
  const v = document.getElementById('gasUrlInput').value.trim();
  if (v && !validUrl(v)) { showToast('⚠️ URL ต้องเป็นลิงก์ script.google.com ที่ลงท้ายด้วย /exec'); return; }
  if (v) LS.set(CFG.URL_LS, v); else LS.del(CFG.URL_LS);
  showToast(v ? '🔗 บันทึก URL แล้ว กำลังดึงข้อมูล...' : 'ล้าง URL แล้ว');
  if (v) pull(true);
}
function cloudLoad() {
  const pin = getPin();
  if (isAppsScriptEnv()) {
    return new Promise((resolve, reject) => {
      google.script.run
        .withSuccessHandler(r => { try { resolve(typeof r === 'string' ? JSON.parse(r) : r); } catch (e) { reject(e); } })
        .withFailureHandler(reject)
        .loadAllDataFromServer(pin);
    });
  }
  const url = apiUrl();
  if (!url) return Promise.reject(new Error('NO_URL'));
  const payload = JSON.stringify({ action: 'load', key: pin });
  return fetch(url, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: payload }).then(r => r.json());
}
function cloudSave(partial) {
  const payload = JSON.stringify({ action: 'save', key: getPin(), store: partial });
  if (isAppsScriptEnv()) {
    return new Promise((resolve, reject) => {
      google.script.run.withSuccessHandler(resolve).withFailureHandler(reject).saveAllDataToServer(payload);
    });
  }
  const url = apiUrl();
  if (!url) return Promise.reject(new Error('NO_URL'));
  return fetch(url, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: payload }).then(r => r.json());
}
function checkServerInfo(res) {
  if (!res) return;
  if (typeof res.pinSet === 'boolean') serverPinSet = res.pinSet;
  const el = document.getElementById('versionInfo');
  if (res.version && el) el.textContent = `หน้าเว็บเวอร์ชัน ${CLIENT_VERSION} | เซิร์ฟเวอร์เวอร์ชัน ${res.version}`;
  if (res.version && res.version !== CLIENT_VERSION && !versionWarned) {
    versionWarned = true;
    showToast(`⚠️ เวอร์ชันไม่ตรงกัน (หน้าเว็บ ${CLIENT_VERSION} / เซิร์ฟเวอร์ ${res.version}) — ผู้ดูแลต้อง Deploy เวอร์ชันใหม่`, 9000);
  }
}
function isTyping() {
  const ae = document.activeElement;
  return !!(ae && ae.closest && ae.closest('#mainContentArea') && /^(INPUT|TEXTAREA|SELECT)$/.test(ae.tagName));
}
function safeRerender() {
  renderSidebar();
  if (isTyping()) { deferRender = true; return; }
  renderMainContent();
}
function applyRemote(remoteRaw) {
  const remote = sanitizeStore(remoteRaw);
  if (!Object.keys(remote).length) return 0;
  backupConflicts(remote);
  const res = mergeStores(appStore, remote);
  appStore = res.store;
  fillMissing(appStore);
  res.taken.forEach(k => pending.delete(k));
  rebaseHashes();
  ensurePeriodExists(getPeriodKey());
  persistLocal();
  persistPending();
  Object.keys(appStore).forEach(pk => { const m = PERIOD_RE.exec(pk); if (m) ensureYearOption(m[2]); });
  safeRerender();
  return res.taken.length;
}
function schedulePush(delay) {
  clearTimeout(pushTimer);
  pushTimer = setTimeout(flushPush, delay == null ? CFG.PUSH_DELAY_MS : delay);
}
async function flushPush() {
  pushTimer = null;
  if (!pending.size || !cloudAvailable() || isReadOnlyLocked()) return;
  if (pushing) { schedulePush(); return; }
  const sent = {}, partial = {};
  [...pending].forEach(key => {
    const act = actByKey(key);
    if (!act) { pending.delete(key); return; }
    const i = key.lastIndexOf('|'), pk = key.slice(0, i), id = key.slice(i + 1);
    (partial[pk] = partial[pk] || { activities: {} }).activities[id] = act;
    sent[key] = Number(act.updatedMs) || 0;
  });
  if (!Object.keys(sent).length) { persistPending(); return; }

  pushing = true;
  setStatus('⏳ กำลังบันทึกขึ้น Google Sheets...');
  const t0 = Date.now();
  try {
    const res = await cloudSave(partial);
    if (res && res.serverTime) syncClock(res.serverTime, t0);
    if (res && res.status === 'unauthorized') {
      if (res.reason === 'locked') {
        setStatus(res.long ? '⏳ ระบบล็อก 6 ชั่วโมงเพราะมีการใส่รหัสผิดสะสม — ให้ผู้ดูแลปลดล็อกในเมนู Sheets (ข้อมูลอยู่ในเครื่องแล้ว)'
          : '⏳ ระบบล็อกชั่วคราวเพราะมีการใส่รหัสผิดหลายครั้ง จะลองส่งใหม่ใน 5 นาที (ข้อมูลอยู่ในเครื่องแล้ว)');
        schedulePush(5 * 60 * 1000);
        return;
      }
      clearPin();
      renderSidebar();
      renderMainContent();
      setStatus('⛔ รหัสแก้ไขไม่ถูกต้องหรือถูกเปลี่ยน ข้อมูลที่แก้ยังอยู่ในเครื่อง ใส่รหัสใหม่แล้วระบบจะส่งให้');
      showToast('🔒 รหัสแก้ไขถูกเปลี่ยน กรุณาใส่รหัสใหม่');
      openPinModal();
      return;
    }
    if (res && res.status === 'busy') { schedulePush(4000); return; }
    if (!res || res.status !== 'ok') throw new Error((res && res.message) || 'server error');
    checkServerInfo(res);

    const stamped = res.stamped || {};
    Object.keys(stamped).forEach(k => {
      const a = actByKey(k);
      if (a && Number(a.updatedMs) === sent[k] && Number(stamped[k]) !== sent[k]) { a.updatedMs = Number(stamped[k]); sent[k] = a.updatedMs; }
    });
    let n = 0;
    if (res.newer && Object.keys(res.newer).length) n = applyRemote(res.newer);
    Object.keys(sent).forEach(k => {
      const a = actByKey(k);
      if (!a || (Number(a.updatedMs) || 0) === sent[k]) pending.delete(k);
    });
    persistLocal();
    persistPending();
    if (n) showToast(`🔄 มีฉบับใหม่กว่าจากเพื่อนร่วมทีม ${n} รายการ ระบบแสดงฉบับล่าสุดแล้ว`);
    setStatus('✅ บันทึกขึ้น Google Sheets แล้ว ' + new Date().toLocaleTimeString('th-TH')
      + (res.viewError ? ' | ⚠️ ตารางสรุปใน Sheets อัปเดตไม่สำเร็จ' : '')
      + (res.rejected && res.rejected.length ? ' | ⚠️ ข้อมูลใหญ่เกิน: ' + res.rejected.join(', ') : ''));
    if (pending.size) schedulePush();
  } catch (e) {
    setStatus('⚠️ ยังส่งขึ้นคลาวด์ไม่ได้ (เก็บในเครื่องแล้ว ระบบจะลองใหม่อัตโนมัติ)');
    schedulePush(30000);
  } finally {
    pushing = false;
  }
}
async function pull(manual) {
  if (!cloudAvailable()) { if (manual) setStatus('⚠️ กรุณาวาง Google Apps Script Web App URL ก่อน'); return; }
  lastPull = Date.now();
  if (manual) setStatus('⏳ กำลังดึงข้อมูลล่าสุด...');
  const t0 = Date.now();
  try {
    const res = await cloudLoad();
    if (res && res.status === 'error') throw new Error(res.message);
    if (res && res.locked) {
      serverPinSet = res.pinSet;
      setStatus('🔒 ต้องใส่ PIN จึงจะดึงข้อมูลได้');
      if (manual) openPinModal();
      return;
    }
    if (res && res.serverTime) syncClock(res.serverTime, t0);
    checkServerInfo(res);
    const store = (res && res.status) ? res.store : res;
    const n = applyRemote(store || {});
    setStatus(`✅ ดึงข้อมูลล่าสุดแล้ว (อัปเดต ${n} รายการ) ` + new Date().toLocaleTimeString('th-TH'));
    if (manual) showToast('⬇️ ดึงข้อมูลล่าสุดเรียบร้อยแล้ว');
    if (pending.size && !isReadOnlyLocked()) schedulePush(500);
  } catch (e) {
    setStatus('⚠️ ดึงข้อมูลไม่ได้ ตรวจสอบ URL / สิทธิ์ Web App / อินเทอร์เน็ต');
  }
}
async function syncWithCloud(dir) {
  const v = document.getElementById('gasUrlInput').value.trim();
  if (v && v !== apiUrl() && validUrl(v)) LS.set(CFG.URL_LS, v);
  if (dir === 'push') {
    if (isReadOnlyLocked()) { showToast('🔒 กรุณาใส่ PIN ก่อนอัปโหลด'); openPinModal(); return; }
    forEachAct(appStore, (pk, id, a) => { if (Number(a.updatedMs) > 0) pending.add(pk + '|' + id); });
    persistPending();
    clearTimeout(pushTimer);
    await flushPush();
  } else {
    await pull(true);
  }
}

