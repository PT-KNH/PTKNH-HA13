function thaiToIsoDate(s) {
  if (!s || typeof s !== 'string') return '';
  s = s.trim();
  if (!s || s === '-') return '';
  const m1 = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (m1) { let y = parseInt(m1[1], 10); if (y > 2400) y -= 543; return `${y}-${m1[2]}-${m1[3]}`; }
  const m2 = s.match(/(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})/);
  if (m2) {
    let y = parseInt(m2[3], 10);
    if (y < 100) y = (y + 2500) - 543; else if (y > 2400) y -= 543;
    return `${y}-${m2[2].padStart(2, '0')}-${m2[1].padStart(2, '0')}`;
  }
  return '';
}
function isoToThaiDate(iso) {
  if (!iso || typeof iso !== 'string') return '-';
  const p = iso.split('-');
  if (p.length !== 3) return iso;
  let y = parseInt(p[0], 10);
  if (isNaN(y)) return iso;
  if (y < 2400) y += 543;
  return `${p[2].padStart(2, '0')}/${p[1].padStart(2, '0')}/${y}`;
}
