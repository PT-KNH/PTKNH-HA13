/* ---------- กิจกรรม 12: KPI ---------- */
function evaluateKpiTarget(targetStr, valStr) {
  const s = String(valStr == null ? '' : valStr).trim();
  if (!s || s === '-') return { pass: null };
  const val = parseFloat(s.replace(/[^0-9.-]/g, ''));
  if (isNaN(val)) return { pass: null };
  const t = String(targetStr || '').trim();
  const m = t.match(/([0-9.]+)/);
  if (!m) return { pass: null };
  const n = parseFloat(m[1]);
  let pass;
  if (t.startsWith('>=')) pass = val >= n;
  else if (t.startsWith('>')) pass = val > n || val === 100;
  else if (t.startsWith('<=')) pass = val <= n;
  else if (t.startsWith('<')) pass = val < n;
  else pass = val === n;
