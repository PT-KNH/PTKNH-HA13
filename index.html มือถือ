      if ([1, 2, 4, 8, 10, 11].includes(meta.id)) {
        rows.forEach(r => { const t = r.event || r.summary || r.issue || r.topic; if (isReal(t)) s.hl[meta.id].push(`[${mName}] ${t}`); });
      } else if (meta.id === 3) {
        const st = a.summaryStats || {};
        s.refer.referTotal += parseInt(st.referTotal, 10) || 0;
        s.refer.refuseTx += parseInt(st.refuseTx, 10) || 0;
        s.refer.reviewedCount += parseInt(st.reviewedCount, 10) || 0;
      } else if (meta.id === 5) {
        Object.values(a.riskMatrix || {}).forEach(c => ['A', 'B', 'C', 'D', 'EI'].forEach(l => { const v = Number(c && c[l]) || 0; s.rm[l] += v; s.rm.total += v; }));
      } else if (meta.id === 6) {
        rows.forEach(r => { if (isReal(r.step)) s.hl[6].push(`[${mName}] ${r.step}`); });
      } else if (meta.id === 9) {
        s.med.total += parseInt((a.headerStats || {}).totalReviewed, 10) || 0;
        const v = medRecAvg(p);
        if (v !== null) { medSum += v; medCnt++; }
      } else if (meta.id === 13) {
        rows.forEach(r => {
          s.train.days += parseFloat(r.days) || 0;
          s.train.hosp += parseFloat(r.budgetHosp) || 0;
          s.train.other += parseFloat(r.budgetOther) || 0;
          if (isReal(r.course)) s.train.courses++;
        });
      } else if (meta.id === 14) {
        const real = r => r && isReal(r.item) && !/ไม่มี/.test(r.item);
        s.env.med += (a.med1_1 || []).filter(real).length;
        s.env.off += (a.off2_1 || []).filter(real).length;
      }
    });
  });
  s.med.avg = medCnt ? (medSum / medCnt).toFixed(2) : null;
  return s;
}
function buildSarMedRecChartSVG(y) {
  const vals = MONTHS_FULL.map(m => { const v = medRecAvg(appStore[`${m}_${y}`]); return v === null ? null : +v.toFixed(1); });
  const w = 520, h = 210, pl = 42, pr = 18, pt = 24, pb = 34, pw = w - pl - pr, ph = h - pt - pb, ty = pt + ph * 0.2;
  let bars = '';
  MONTHS_SHORT.forEach((ms, i) => {
    const x = pl + (pw / 12) * (i + 0.5), v = vals[i];
    if (v !== null) {
      const bh = Math.max(4, (Math.min(100, v) / 100) * ph), top = pt + ph - bh, c = v >= 80 ? '#0f766e' : '#dc2626';
      bars += `<rect x="${x - 11}" y="${top}" width="22" height="${bh}" rx="4" fill="${c}" /><text x="${x}" y="${top - 5}" text-anchor="middle" font-size="10" font-weight="bold" fill="${c}">${v}%</text>`;
    } else bars += `<text x="${x}" y="${pt + ph - 6}" text-anchor="middle" font-size="10" fill="#94a3b8">-</text>`;
    bars += `<text x="${x}" y="${h - 10}" text-anchor="middle" font-size="11" fill="#475569">${ms}</text>`;
  });
  return `<svg viewBox="0 0 ${w} ${h}" style="width:100%; height:auto; overflow:visible;"><line x1="${pl}" y1="${pt}" x2="${pl}" y2="${pt + ph}" stroke="#cbd5e1" /><line x1="${pl}" y1="${pt + ph}" x2="${w - pr}" y2="${pt + ph}" stroke="#cbd5e1" />
    <line x1="${pl}" y1="${ty}" x2="${w - pr}" y2="${ty}" stroke="#d97706" stroke-dasharray="4,4" stroke-width="1.5" /><text x="${w - pr}" y="${ty - 4}" text-anchor="end" font-size="10" font-weight="bold" fill="#d97706">เป้าหมาย 80%</text>
    <text x="${pl - 6}" y="${pt + 4}" text-anchor="end" font-size="10" fill="#64748b">100%</text><text x="${pl - 6}" y="${pt + ph}" text-anchor="end" font-size="10" fill="#64748b">0%</text>${bars}</svg>`;
}
function buildSarRmTrendChartSVG(y) {
  const ad = [], ei = [];
  let max = 5;
  MONTHS_FULL.forEach(m => {
    const p = appStore[`${m}_${y}`], a5 = p && p.activities && p.activities[5];
    let x = 0, z = 0;
    if (a5 && a5.riskMatrix) Object.values(a5.riskMatrix).forEach(c => { x += (Number(c.A) || 0) + (Number(c.B) || 0) + (Number(c.C) || 0) + (Number(c.D) || 0); z += Number(c.EI) || 0; });
    ad.push(x); ei.push(z);
    if (x + z > max) max = x + z + 2;
  });
  const w = 520, h = 210, pl = 36, pr = 18, pt = 24, pb = 34, pw = w - pl - pr, ph = h - pt - pb;
  let bars = '';
  MONTHS_SHORT.forEach((ms, i) => {
    const x = pl + (pw / 12) * (i + 0.5), hA = (ad[i] / max) * ph, hE = (ei[i] / max) * ph, yA = pt + ph - hA, yE = yA - hE;
    if (ad[i] > 0) bars += `<rect x="${x - 10}" y="${yA}" width="20" height="${Math.max(3, hA)}" fill="#0284c7" rx="2" />`;
    if (ei[i] > 0) bars += `<rect x="${x - 10}" y="${yE}" width="20" height="${Math.max(3, hE)}" fill="#dc2626" rx="2" />`;
    bars += `<text x="${x}" y="${yE - 5}" text-anchor="middle" font-size="10" font-weight="bold" fill="${ei[i] > 0 ? '#dc2626' : '#475569'}">${ad[i] + ei[i]}</text><text x="${x}" y="${h - 10}" text-anchor="middle" font-size="11" fill="#475569">${ms}</text>`;
  });
  return `<svg viewBox="0 0 ${w} ${h}" style="width:100%; height:auto; overflow:visible;"><line x1="${pl}" y1="${pt}" x2="${pl}" y2="${pt + ph}" stroke="#cbd5e1" /><line x1="${pl}" y1="${pt + ph}" x2="${w - pr}" y2="${pt + ph}" stroke="#cbd5e1" />
    <text x="${pl - 6}" y="${pt + 6}" text-anchor="end" font-size="10" fill="#64748b">${max}</text><text x="${pl - 6}" y="${pt + ph}" text-anchor="end" font-size="10" fill="#64748b">0</text>
    <rect x="${w - 170}" y="2" width="10" height="10" fill="#0284c7" rx="2" /><text x="${w - 155}" y="11" font-size="10" fill="#334155">ระดับ A–D</text>
    <rect x="${w - 95}" y="2" width="10" height="10" fill="#dc2626" rx="2" /><text x="${w - 80}" y="11" font-size="10" fill="#334155">ระดับ E–I</text>${bars}</svg>`;
}
function renderSarSummary(container) {
