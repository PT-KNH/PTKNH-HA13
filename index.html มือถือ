    <div class="stats-grid">
      <div class="stat-card"><span class="stat-label">อุบัติการณ์ RM ทั้งปี</span><span class="stat-value">${s.rm.total} ครั้ง</span><span class="stat-sub">A–D: ${s.rm.A + s.rm.B + s.rm.C + s.rm.D} | E–I: ${s.rm.EI}</span></div>
      <div class="stat-card"><span class="stat-label">ความสมบูรณ์เวชระเบียนเฉลี่ย</span><span class="stat-value" style="color:var(--primary);">${medTxt}</span><span class="stat-sub">สุ่มทบทวนสะสม ${s.med.total} ราย</span></div>
      <div class="stat-card"><span class="stat-label">การอบรมทั้งปี</span><span class="stat-value" style="color:var(--accent);">${s.train.days} วัน</span><span class="stat-sub">งบ รพ. ${s.train.hosp.toLocaleString()} | งบอื่น ${s.train.other.toLocaleString()} บาท</span></div>
