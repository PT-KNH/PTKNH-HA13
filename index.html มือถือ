    if (v == null) return;
    if (typeof v === 'object') {
      Object.keys(v).forEach(k => {
        if (CFG.IGNORE_KEYS.includes(k) || k.charAt(0) === '_') return;
        walk(v[k], path ? `${path} > ${FIELD_LABELS[k] || k}` : (FIELD_LABELS[k] || k));
