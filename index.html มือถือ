        <button class="btn btn-primary" onclick="copyAllFromPreviousMonth()">🔄 ดึงข้อมูลเดือนก่อน (ทั้ง 13 เรื่อง)</button>
        <button class="btn btn-success" onclick="copyLineGroupSummary()">💬 คัดลอกสรุปส่ง LINE</button>
        <button class="btn btn-accent" onclick="batchExportAllWord()">📦 Export Word ทั้งหมด</button>
