function renderSidebar() {
  const nav = document.getElementById('sidebarNavList');
  const ownerFilter = document.getElementById('ownerFilter').value;
  const pd = getCurrentPeriodData();
  nav.innerHTML = '';
  ACTIVITIES_META.forEach(meta => {
    if (ownerFilter !== 'ALL' && meta.owner !== ownerFilter) return;
    const st = (pd.activities[meta.id] || {}).status || 'todo';
    const badge = st === 'done' ? '<span class="badge badge-done">✓ ส่งแล้ว</span>'
      : st === 'progress' ? '<span class="badge badge-progress">กำลังกรอก</span>' : '<span class="badge badge-todo">ยังไม่ส่ง</span>';
    const btn = document.createElement('button');
    btn.className = `nav-item ${currentView === meta.id ? 'active' : ''}`;
    btn.onclick = () => selectView(meta.id);
    btn.innerHTML = `<div class="nav-item-left"><div class="nav-item-title">${meta.shortTitle}</div><div class="nav-item-owner">👤 ${meta.owner}</div></div>${badge}`;
    nav.appendChild(btn);
  });
}
function selectView(v) { currentView = v; renderSidebar(); renderMainContent(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
function renderMainContent() {
  const c = document.getElementById('mainContentArea');
