function renderGlobalSearch(container) {
  const kws = ['Stroke', 'หกล้ม', 'TUG', 'CPG', 'Ultrasound', 'เวชระเบียน', 'ติดเชื้อ'];
  container.innerHTML = `
    <div class="activity-banner"><div class="activity-banner-info"><h2>🔍 ค้นหาประเด็นทบทวนย้อนหลังข้ามเดือน</h2><p>ค้นหาจากทุกเดือนและทุกกิจกรรม เช่น Stroke, หกล้ม, TUG, CPG, Ultrasound หรือชื่อผู้รับผิดชอบ</p></div>
      <div><button class="btn btn-outline" onclick="selectView('dashboard')">← กลับหน้า Dashboard</button></div></div>
    <div class="card"><div class="card-body">
      <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:12px;">
        <input type="text" id="globalSearchInput" value="${esc(lastSearchQuery)}" placeholder="พิมพ์คำค้นหา..." style="flex:1; min-width:260px; padding:10px 14px; border:1px solid var(--slate-300); border-radius:8px; font-family:inherit; font-size:15px;" oninput="executeGlobalSearch(this.value)" />
        <button class="btn btn-outline" onclick="document.getElementById('globalSearchInput').value=''; executeGlobalSearch('')">แสดงทั้งหมด</button></div>
      <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:16px;"><span style="font-size:12.5px; color:var(--slate-500); font-weight:600;">คำค้นหายอดนิยม:</span>
        ${kws.map(k => `<button class="btn btn-outline btn-sm" onclick="document.getElementById('globalSearchInput').value='${k}'; executeGlobalSearch('${k}')">${k}</button>`).join('')}</div>
      <div id="globalSearchResults"></div></div></div>`;
  executeGlobalSearch(lastSearchQuery);
}
function extractReadableSnippet(actId, act, q) {
  const parts = [];
  const take = s => { if (s && (!q || s.toLowerCase().includes(q))) parts.push(s); };
  const LABEL_ONLY = ['method', 'type', 'category', 'content', 'position', 'days', 'budgetHosp', 'budgetOther'];
  const join = r => {
    const keys = Object.keys(r || {}).filter(k => k.charAt(0) !== '_');
    if (!keys.some(k => !LABEL_ONLY.includes(k) && isReal(r[k]))) return '';
    return keys.map(k => r[k]).filter(isReal).join(' | ');
  };
  (Array.isArray(act.rows) ? act.rows : []).forEach(r => take(join(r)));
  if (actId === 5) (act.incidentLogs || []).forEach(l => take(isReal(l.detail) ? `[ระดับ ${l.level}] ${l.detail} → ${isReal(l.action) ? l.action : '-'}` : ''));
  if (actId === 6) (act.icIndicators || []).forEach(i => take(isReal(i.value) ? `${i.label}: ${i.value}` : ''));
  if (actId === 12 && q) (act.kpis || []).forEach(k => take(`${k.name} (เป้า ${k.target}, ${k.owner})`));
  if (actId === 14) ENV_KEYS.forEach(key => (act[key] || []).forEach(r => take(join(r))));
  return parts.slice(0, 2).join(' ; ');
}
function executeGlobalSearch(query) {
  lastSearchQuery = String(query || '').trim();
  const q = lastSearchQuery.toLowerCase(), box = document.getElementById('globalSearchResults');
  if (!box) return;
  const order = pk => { const m = PERIOD_RE.exec(pk); return m ? Number(m[2]) * 100 + MONTHS_FULL.indexOf(m[1]) : 0; };
  const hits = [];
  Object.keys(appStore).filter(pk => PERIOD_RE.test(pk)).sort((a, b) => order(b) - order(a)).forEach(pk => {
    const p = appStore[pk], [month, year] = pk.split('_');
    ACTIVITIES_META.forEach(meta => {
      const act = p.activities && p.activities[meta.id];
      if (!act) return;
      const metaHit = q && `${meta.code} ${meta.title} ${meta.owner}`.toLowerCase().includes(q);
      let snip = extractReadableSnippet(meta.id, act, metaHit ? '' : q);
      if (!snip && metaHit && (Number(act.updatedMs) > 0 || act.status !== 'todo')) snip = '(ตรงกับชื่อกิจกรรม/ผู้รับผิดชอบ)';
      if (snip) hits.push({ month, year, meta, snip });
    });
  });
  if (!hits.length) {
    box.innerHTML = `<div style="padding:24px; text-align:center; color:var(--slate-500);">ไม่พบข้อมูล${lastSearchQuery ? ` ที่ตรงกับ "<strong>${esc(lastSearchQuery)}</strong>"` : ''}</div>`;
    return;
  }
  box.innerHTML = `<div style="margin-bottom:10px; font-size:13.5px; color:var(--slate-600);">พบ <strong>${hits.length} รายการ</strong>${hits.length > 300 ? ' (แสดง 300 รายการแรกราย)' : ''}</div>`
    + tableWrap(['เดือน/ปีงบ', 'รหัส', 'กิจกรรม', 'ผู้รับผิดชอบ', 'รายละเอียดที่พบ', ''], hits.slice(0, 300).map(h => `<tr><td style="white-space:nowrap;"><strong>${esc(h.month)} ${esc(h.year)}</strong></td><td style="white-space:nowrap;">${h.meta.code}</td><td>${h.meta.title}</td><td style="white-space:nowrap;">${h.meta.owner}</td><td>${esc(h.snip)}</td>
      <td><button class="btn btn-primary btn-sm" onclick="jumpToPeriodAndActivity('${esc(h.month)}', '${esc(h.year)}', ${h.meta.id})">เปิดดู</button></td></tr>`).join(''));
}
function jumpToPeriodAndActivity(month, year, actId) {
  ensureYearOption(year);
  document.getElementById('selectMonth').value = month;
  document.getElementById('selectYear').value = String(year);
  ensurePeriodExists(`${month}_${year}`);
  selectView(actId);
}

/* ============================ 14) เริ่มต้นระบบและการจัดการ UI มือถือ ============================ */
function ensureYearOption(y) {
  const ys = document.getElementById('selectYear');
  if (!ys || [...ys.options].some(o => o.value === String(y))) return;
  const vals = [...ys.options].map(o => Number(o.value)).concat(Number(y)).sort((a, b) => a - b);
  const cur = ys.value;
  ys.innerHTML = vals.map(v => `<option value="${v}">${v}</option>`).join('');
  ys.value = cur;
}
function initPeriodSelectors() {
  const now = new Date();
  const mi = (now.getMonth() + 3) % 12;   // ต.ค. = 0
  const yBE = now.getFullYear() + 543 + (CFG.YEAR_IS_FISCAL && now.getMonth() >= 9 ? 1 : 0);
  const ms = document.getElementById('selectMonth'), ys = document.getElementById('selectYear');
  ms.innerHTML = MONTHS_FULL.map(m => `<option value="${m}">${m}</option>`).join('');
  const years = [];
  for (let y = yBE - 3; y <= yBE + 1; y++) years.push(y);
  ys.innerHTML = years.map(y => `<option value="${y}">${y}</option>`).join('');
  ms.value = MONTHS_FULL[mi];
  ys.value = String(yBE);
}

function toggleDrawer() {
  document.querySelector('.sidebar').classList.toggle('open');
  document.getElementById('drawerBackdrop').classList.toggle('show');
  document.body.classList.toggle('drawer-open');
}
function closeDrawer() {
  const side = document.querySelector('.sidebar');
  if (!side) return;
  side.classList.remove('open');
  document.getElementById('drawerBackdrop').classList.remove('show');
  document.body.classList.remove('drawer-open');
}
function syncBottomNav() {
  document.querySelectorAll('.bottom-nav button[data-view]').forEach(b => {
    b.classList.toggle('active', b.dataset.view === String(currentView));
  });
}

document.addEventListener('focusout', () => {
  if (!deferRender) return;
  setTimeout(() => { if (!isTyping()) { deferRender = false; renderMainContent(); } }, 300);
});
document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'visible' && Date.now() - lastPull > CFG.PULL_MIN_INTERVAL_MS) pull(false);
});
window.addEventListener('online', () => { if (!isReadOnlyLocked()) schedulePush(500); });
window.addEventListener('beforeunload', e => {
  if (pending.size && cloudAvailable() && !isReadOnlyLocked()) { e.preventDefault(); e.returnValue = ''; }
});
window.addEventListener('resize', () => {
  if (window.innerWidth >= 1100) closeDrawer();
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closeDrawer();
});

window.addEventListener('DOMContentLoaded', () => {
  initPeriodSelectors();
  loadStore();
  renderSidebar();
  renderMainContent();
  verifyStoredPin();
  if (cloudAvailable()) pull(false);
});
