function importBackupJSON(event) {
  const input = event.target, file = input.files && input.files[0];
  if (!file) return;
  if (isReadOnlyLocked()) { input.value = ''; showToast('🔒 กรุณาใส่ PIN ก่อนนำเข้าข้อมูล'); openPinModal(); return; }
  if (file.size > 10 * 1024 * 1024) { input.value = ''; alert('ไฟล์ใหญ่เกิน 10 MB'); return; }
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const parsed = sanitizeStore(JSON.parse(e.target.result));
      const n = Object.keys(parsed).length;
      if (!n) { alert('ไฟล์ไม่มีข้อมูลที่ใช้ได้ หรือรูปแบบไม่ถูกต้อง'); return; }
      if (!confirm(`พบข้อมูล ${n} เดือนในไฟล์\nระบบจะ "รวม" กับข้อมูลเดิม โดยเก็บฉบับที่แก้ไขล่าสุดของแต่ละกิจกรรม\nดำเนินการต่อหรือไม่?`)) return;
      forEachAct(parsed, (pk, id, a) => { normalizeTypes(a); if (!a.updatedMs && String(a.updatedAt || '').trim()) a.updatedMs = 1; });
      const res = mergeStores(appStore, parsed);
      appStore = res.store;
      fillMissing(appStore);
      res.taken.forEach(k => { if (Number((actByKey(k) || {}).updatedMs) > 0) pending.add(k); });
      rebaseHashes();
      ensurePeriodExists(getPeriodKey());
      persistLocal();
      persistPending();
      schedulePush(500);
      Object.keys(appStore).forEach(pk => { const m = PERIOD_RE.exec(pk); if (m) ensureYearOption(m[2]); });
      renderSidebar();
      renderMainContent();
      showToast(`📂 นำเข้าและรวมข้อมูล ${res.taken.length} รายการแล้ว`);
    } catch (err) {
      alert('ไฟล์ JSON ไม่ถูกต้อง');
    } finally {
      input.value = '';
    }
  };
  reader.readAsText(file);
}

