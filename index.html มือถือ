}
function buildSingleKpiRunChartSVG(k) {
  if (!k) return '<div style="color:var(--slate-500); padding:10px;">ยังไม่มีตัวชี้วัด</div>';
  const nums = (k.months || []).map(v => {
    const s = String(v == null ? '' : v).trim();
    if (!s || s === '-') return null;
    const n = parseFloat(s.replace(/[^0-9.-]/g, ''));
    return isNaN(n) ? null : n;
  });
  while (nums.length < 12) nums.push(null);
  const tm = String(k.target || '').match(/([0-9.]+)/), tn = tm ? parseFloat(tm[1]) : null;
  let max = 100;
  nums.forEach(n => { if (n !== null && n > max) max = n * 1.15; });
  if (tn !== null && tn <= 15 && nums.every(n => n === null || n <= 20)) max = Math.max(20, tn * 2 || 10);
  const w = 680, h = 175, pl = 42, pr = 20, pt = 22, pb = 30, pw = w - pl - pr, ph = h - pt - pb;
  const pts = [];
  let dots = '';
  MONTHS_SHORT.forEach((ms, i) => {
    const x = pl + (pw / 12) * (i + 0.5), v = nums[i];
    if (v !== null) {
      const y = pt + ph - Math.min(ph, Math.max(0, (v / max) * ph));
      pts.push(`${x},${y}`);
      const c = evaluateKpiTarget(k.target, v).pass === false ? '#dc2626' : '#0f766e';
      dots += `<circle cx="${x}" cy="${y}" r="4.5" fill="${c}" stroke="#fff" stroke-width="1.5" /><text x="${x}" y="${y - 8}" text-anchor="middle" font-size="10.5" font-weight="bold" fill="${c}">${v}</text>`;
    } else {
      dots += `<text x="${x}" y="${pt + ph - 6}" text-anchor="middle" font-size="10" fill="#94a3b8">-</text>`;
    }
    dots += `<text x="${x}" y="${h - 8}" text-anchor="middle" font-size="11" fill="#475569">${ms}</text>`;
  });
  let target = '';
  if (tn !== null && tn <= max) {
    const ty = pt + ph - (tn / max) * ph;
    target = `<line x1="${pl}" y1="${ty}" x2="${w - pr}" y2="${ty}" stroke="#d97706" stroke-dasharray="5,4" stroke-width="1.5" /><text x="${w - pr}" y="${ty - 4}" text-anchor="end" font-size="10" font-weight="bold" fill="#d97706">เป้าหมาย: ${esc(k.target)}</text>`;
  }
  return `<svg viewBox="0 0 ${w} ${h}" style="width:100%; height:auto; overflow:visible;">
    <line x1="${pl}" y1="${pt}" x2="${pl}" y2="${pt + ph}" stroke="#cbd5e1" /><line x1="${pl}" y1="${pt + ph}" x2="${w - pr}" y2="${pt + ph}" stroke="#cbd5e1" />
    <text x="${pl - 6}" y="${pt + 6}" text-anchor="end" font-size="10" fill="#64748b">${Math.round(max)}</text><text x="${pl - 6}" y="${pt + ph}" text-anchor="end" font-size="10" fill="#64748b">0</text>
    ${target}${pts.length > 1 ? `<polyline fill="none" stroke="#0284c7" stroke-width="2.2" points="${pts.join(' ')}" />` : ''}${dots}</svg>`;
}
