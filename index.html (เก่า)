/**
 * บันทึกข้อมูลจากหน้าเว็บลง ScriptProperties และอัปเดตลงแท็บใน Google Sheets อัตโนมัติ
 */
/**
 * 🛡️ Smart Merge รายกิจกรรม (พร้อม LockService ป้องกันการชนกันเมื่อกดบันทึกพร้อมกันหลายเครื่อง)
 * เปรียบเทียบเวลาแก้ไขล่าสุด (updatedMs) แยกรายเดือนและรายกิจกรรม เพื่อไม่ให้ข้อมูลของเพื่อนร่วมทีมถูกเขียนทับ
 */
function saveAllDataToServer(jsonString) {
  const lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    const prop = PropertiesService.getScriptProperties();
    const existingRaw = prop.getProperty(STORE_PROP_KEY) || &#x27;{}&#x27;;
    let existingStore = {};
    try {
      existingStore = JSON.parse(existingRaw);
    } catch (e) {
      existingStore = {};
    }
    const incoming = JSON.parse(jsonString);
    const mergedStore = smartMergeStores(existingStore, incoming);
    const mergedJson = JSON.stringify(mergedStore);
    prop.setProperty(STORE_PROP_KEY, mergedJson);
    syncAllToSpreadsheet(mergedStore);
    return {
      status: &#x27;ok&#x27;,
      timestamp: Utilities.formatDate(new Date(), &#x27;Asia/Bangkok&#x27;, &#x27;dd/MM/yyyy HH:mm:ss&#x27;)
    };
  } finally {
    lock.releaseLock();
  }
}
/**
 * ฟังก์ชันรวมข้อมูลรายกิจกรรมโดยยึดข้อมูลของกิจกรรมที่มีเวลาแก้ไข (updatedMs) ล่าสุดเสมอ
 */
function smartMergeStores(serverStore, clientStore) {
  if (!serverStore || typeof serverStore !== &#x27;object&#x27;) return clientStore;
  if (!clientStore || typeof clientStore !== &#x27;object&#x27;) return serverStore;
  const result = JSON.parse(JSON.stringify(serverStore));
  Object.keys(clientStore).forEach(periodKey =&gt; {
    const clientPeriod = clientStore[periodKey];
    if (!clientPeriod || !clientPeriod.activities) return;
    if (!result[periodKey] || !result[periodKey].activities) {
      result[periodKey] = clientPeriod;
      return;
    }
    Object.keys(clientPeriod.activities).forEach(actId =&gt; {
      const clientAct = clientPeriod.activities[actId];
      const serverAct = result[periodKey].activities[actId];
      if (!serverAct) {
        result[periodKey].activities[actId] = clientAct;
      } else {
        const clientTime = Number(clientAct.updatedMs) || 0;
        const serverTime = Number(serverAct.updatedMs) || 0;
        // หากฝั่ง Client มีการแก้ไขใหม่กว่า หรือยังไม่มี timestamp ให้ใช้ข้อมูลใหม่จาก Client
        if (clientTime &gt;= serverTime) {
          result[periodKey].activities[actId] = clientAct;
        }
      }
    });
  });
  return result;
}
/**
 * สร้างโครงสร้างแท็บเริ่มต้นทั้ง 13 กิจกรรม + Dashboard ใน Google Sheets
