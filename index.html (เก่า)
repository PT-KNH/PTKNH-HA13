<body>
  <!-- Topbar -->
  <header class="topbar">
    <div class="brand">
      <div class="brand-icon">PT</div>
      <div class="brand-text">
        <h1>ระบบบันทึกและทบทวนคุณภาพ 13 กิจกรรม (HA)</h1>
        <p>งานกายภาพบำบัด กลุ่มงานเวชกรรมฟื้นฟู โรงพยาบาลเขื่องใน จ.อุบลราชธานี</p>
      </div>
    </div>
    <div class="topbar-controls">
      <div class="period-selector">
        <label for="selectMonth">ประจำเดือน:</label>
        <select id="selectMonth" onchange="onPeriodChange()">
          <option value="ตุลาคม" selected>ตุลาคม</option>
          <option value="พฤศจิกายน">พฤศจิกายน</option>
          <option value="ธันวาคม">ธันวาคม</option>
          <option value="มกราคม">มกราคม</option>
          <option value="กุมภาพันธ์">กุมภาพันธ์</option>
          <option value="มีนาคม">มีนาคม</option>
          <option value="เมษายน">เมษายน</option>
          <option value="พฤษภาคม">พฤษภาคม</option>
          <option value="มิถุนายน">มิถุนายน</option>
          <option value="กรกฎาคม">กรกฎาคม</option>
          <option value="สิงหาคม">สิงหาคม</option>
          <option value="กันยายน">กันยายน</option>
        </select>
        <select id="selectYear" onchange="onPeriodChange()">
          <option value="2567">2567</option>
          <option value="2568">2568</option>
          <option value="2569">2569</option>
          <option value="2570" selected>2570</option>
        </select>
      </div>
      <button class="btn btn-glass" id="pinModeBtn" onclick="togglePinLockModal()">
        🔓 โหมดทีมงาน (แก้ไขได้)
      </button>
      <button class="btn btn-glass" onclick="openCloudModal()">
        ☁️ เชื่อมต่อ Google Sheets / PWA
      </button>
      <button class="btn btn-glass" onclick="exportAllBackupJSON()">
        💾 สำรองข้อมูล (.json)
      </button>
      <label class="btn btn-glass" style="cursor:pointer;">
        📂 นำเข้าไฟล์ข้อมูล
        <input type="file" accept=".json" style="display:none" onchange="importBackupJSON(event)" />
      </label>
    </div>
  </header>
  <!-- Main Workspace -->
  <div class="app-container">
    <!-- Left Sidebar -->
    <aside class="sidebar">
      <button class="btn btn-primary" style="width:100%; justify-content:flex-start;" onclick="selectView('dashboard')">
        📊 หน้าแรก Dashboard ติดตามงาน
      </button>
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:6px;">
        <button class="btn btn-accent btn-sm" style="justify-content:center; padding:8px 6px;" onclick="selectView('sar')">
          📈 สรุปรายปี (SAR)
        </button>
        <button class="btn btn-outline btn-sm" style="justify-content:center; padding:8px 6px;" onclick="selectView('search')">
          🔍 ค้นหาย้อนหลัง
        </button>
      </div>
      <div class="filter-box">
        <label for="ownerFilter">👤 กรองตามผู้รับผิดชอบ:</label>
        <select id="ownerFilter" onchange="renderSidebar()">
          <option value="ALL">แสดงทั้งหมด (13 กิจกรรม)</option>
          <option value="กภ.กิตติ สมบรรดา">กภ.กิตติ สมบรรดา (4 เรื่อง)</option>
          <option value="กภ.ชัยวัฒน์ ชคัตตรัย">กภ.ชัยวัฒน์ ชคัตตรัย (3 เรื่อง)</option>
          <option value="กภ.ธัญพร ทองด้วง">กภ.ธัญพร ทองด้วง (2 เรื่อง)</option>
          <option value="กภ.สรัลชนา สาธุภาค">กภ.สรัลชนา สาธุภาค (2 เรื่อง)</option>
          <option value="กภ.ปิยวรรณ ทองไทย">กภ.ปิยวรรณ ทองไทย (1 เรื่อง)</option>
          <option value="กภ.ศศิธร ประมูลพงศ์">กภ.ศศิธร ประมูลพงศ์ (1 เรื่อง)</option>
        </select>
      </div>
      <div style="font-size:12px; font-weight:700; color:var(--slate-500); padding: 0 4px;">
        รายการกิจกรรม (ยกเว้นกิจกรรมที่ 7)
      </div>
      <div class="nav-list" id="sidebarNavList"></div>
