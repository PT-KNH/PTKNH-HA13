      sh.appendRow([`กิจกรรมที่ ${def.id}: ${def.title}`, `ผู้รับผิดชอบ: ${def.owner}`]);
      sh.appendRow([&#x27;ประจำเดือน/ปี&#x27;, &#x27;สถานะ&#x27;, &#x27;เวลาอัปเดตล่าสุด&#x27;, &#x27;ข้อมูลสรุป / รายการที่บันทึก (JSON / ตาราง)&#x27;]);
      sh.getRange(1, 1, 2, 2).setFontWeight(&#x27;bold&#x27;);
      sh.getRange(3, 1, 1, 4).setFontWeight(&#x27;bold&#x27;).setBackground(&#x27;#e0f2fe&#x27;);
      sh.setFrozenRows(3);
    }
