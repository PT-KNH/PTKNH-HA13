/**
 * ซิงค์ข้อมูลจาก Store ลงตาราง Google Sheets ทั้งแท็บ Dashboard และแท็บรายกิจกรรม
 */
function syncAllToSpreadsheet(allData) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) return;
  let dash = ss.getSheetByName(&#x27;Dashboard_สรุปสถานะ&#x27;);
  if (!dash) dash = ss.insertSheet(&#x27;Dashboard_สรุปสถานะ&#x27;, 0);
  dash.clearContents();
  const dashRows = [[&#x27;ประจำเดือน/ปี&#x27;, &#x27;รหัสกิจกรรม&#x27;, &#x27;ชื่อกิจกรรม&#x27;, &#x27;ผู้รับผิดชอบ&#x27;, &#x27;สถานะ&#x27;, &#x27;เวลาอัปเดตล่าสุด&#x27;]];
  Object.keys(allData).forEach(periodKey =&gt; {
    const periodObj = allData[periodKey];
    if (!periodObj || !periodObj.activities) return;
    ACTIVITY_DEFS.forEach(def =&gt; {
      const act = periodObj.activities[def.id] || {};
      const stMap = { done: &#x27;ส่งรายงานแล้ว&#x27;, progress: &#x27;กำลังดำเนินการ&#x27;, todo: &#x27;ยังไม่ส่ง&#x27; };
      const stLabel = stMap[act.status] || &#x27;ยังไม่ส่ง&#x27;;
      dashRows.push([
        periodKey.replace(&#x27;_&#x27;, &#x27; &#x27;),
        &#x27;กิจกรรมที่ &#x27; + def.id,
        def.title,
        def.owner,
        stLabel,
        act.updatedAt || &#x27;-&#x27;
      ]);
      // อัปเดตแท็บรายกิจกรรม
      let sh = ss.getSheetByName(def.tabName);
      if (!sh) {
        sh = ss.insertSheet(def.tabName);
        sh.appendRow([`ทบทวน 12 กิจกรรม งานกายภาพบำบัด กลุ่มงานเวชกรรมฟื้นฟู โรงพยาบาลเขื่องใน`]);
        sh.appendRow([`กิจกรรมที่ ${def.id}: ${def.title}`, `ผู้รับผิดชอบ: ${def.owner}`]);
        sh.appendRow([&#x27;ประจำเดือน/ปี&#x27;, &#x27;สถานะ&#x27;, &#x27;เวลาอัปเดตล่าสุด&#x27;, &#x27;รายละเอียดข้อมูล&#x27;]);
      }
      syncSingleActivityTab(sh, periodKey, def, act);
    });
  });
  if (dashRows.length &gt; 0) {
    dash.getRange(1, 1, dashRows.length, 6).setValues(dashRows);
    dash.getRange(1, 1, 1, 6).setFontWeight(&#x27;bold&#x27;).setBackground(&#x27;#0f766e&#x27;).setFontColor(&#x27;#ffffff&#x27;);
    dash.autoResizeColumns(1, 6);
  }
}
/**
 * บันทึกหรืออัปเดตแถวข้อมูลของแต่ละเดือนในแท็บของกิจกรรมนั้นๆ
 */
function syncSingleActivityTab(sh, periodKey, def, act) {
  const periodLabel = periodKey.replace(&#x27;_&#x27;, &#x27; &#x27;);
  const stMap = { done: &#x27;ส่งรายงานแล้ว&#x27;, progress: &#x27;กำลังดำเนินการ&#x27;, todo: &#x27;ยังไม่ส่ง&#x27; };
  const stLabel = stMap[act.status] || &#x27;ยังไม่ส่ง&#x27;;
  const summaryText = summarizeActivityForSheet(def.id, act);
  const lastRow = sh.getLastRow();
  let foundRow = -1;
  if (lastRow &gt;= 4) {
    const periods = sh.getRange(4, 1, lastRow - 3, 1).getValues();
    for (let i = 0; i &lt; periods.length; i++) {
      if (String(periods[i][0]) === periodLabel) {
        foundRow = i + 4;
        break;
      }
    }
  }
  const rowValues = [[periodLabel, stLabel, act.updatedAt || &#x27;-&#x27;, summaryText]];
  if (foundRow !== -1) {
    sh.getRange(foundRow, 1, 1, 4).setValues(rowValues);
  } else {
    sh.appendRow(rowValues[0]);
  }
}
/**
 * แปลงข้อมูลแต่ละกิจกรรมให้เป็นข้อความสรุปอ่านง่ายในเซลล์ของ Google Sheets
 */
function summarizeActivityForSheet(actId, act) {
  if (!act) return &#x27;-&#x27;;
  if (actId === 1 &amp;&amp; act.rows) {
    return act.rows.map(r =&gt; `[${r.method}] ${r.event} -&gt; แก้ไข: ${r.action}`).join(&#x27; | &#x27;);
  }
  if (actId === 2 &amp;&amp; act.rows) {
    return act.rows.map(r =&gt; `(${r.date}) [${r.type}] ${r.summary} -&gt; ${r.solution}`).join(&#x27; | &#x27;);
  }
  if (actId === 3 &amp;&amp; act.summaryStats) {
    const s = act.summaryStats;
    return `ส่งต่อรวม ${s.referTotal} ราย, ไม่สมัครใจอยู่/ปฏิเสธ ${s.againstAdvice}/${s.refuseTx} ราย, ทบทวน ${s.reviewedCount} ราย`;
  }
